# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling
.claude

# source design assets — 3ds Max archives and raw render/drawing files.
# These live locally only; GitHub rejects files over 100MB and they would
# bloat history permanently. Web-ready exports go in public/images/.
*.zip
*.max
*.rar
/Tasnim/

# typescript
*.tsbuildinfo
next-env.d.ts

# Stray media dropped into the repo root — raw photos and video from her camera
# roll land here on the way to the bot. GitHub rejects anything over 100MB, and a
# single .MOV already blocked a push. Web-ready exports live in public/images/.
/*.MOV
/*.mov
/*.mp4
/*.jpg
/*.jpeg
/*.png
/*.heic
/*.HEIC
